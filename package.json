{
  "name": "sfterm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "tauri": "node scripts/run-with-project-target.mjs tauri",
    "icons": "node scripts/copy-icons.mjs",
    "predev": "npm run icons",
    "prebuild": "npm run icons",
    "test": "node scripts/run-tests.mjs",
    "test:shell:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-powershell-integration.ps1",
    "test:process-tree:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-windows-process-tree.ps1",
    "test:ptyd-primitives:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-windows-ptyd-primitives.ps1",
    "test:ptyd-e2e:windows": "node scripts/run-with-project-target.mjs cargo test --manifest-path src-tauri/Cargo.toml --locked ptyd::windows_e2e_tests -- --ignored --test-threads=1",
    "env:check": "node scripts/check-environment.mjs",
    "cargo:doctor": "node scripts/check-cargo.mjs",
    "cargo:doctor:online": "node scripts/check-cargo.mjs --online",
    "check:platform-boundaries": "node scripts/check-platform-boundaries.mjs",
    "setup:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-windows.ps1",
    "check:rust": "node scripts/run-with-project-target.mjs cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "test:rust": "node scripts/run-with-project-target.mjs cargo test --manifest-path src-tauri/Cargo.toml --locked --quiet",
    "validate:frontend": "npm run lint && npm run test && npm run build",
    "validate": "npm run validate:frontend && npm run check:platform-boundaries && npm run test:rust"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.6",
    "material-icon-theme": "^5.36.1",
    "mermaid": "^11.16.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
